# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://recon:recon@localhost:5432/recon
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3 compatible: AWS S3 / Cloudflare R2 / MinIO) -------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=recon-local
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1

# --- Authentication (buy, do not build: Auth0 / WorkOS / Clerk) ----------
AUTH_ISSUER=https://example-tenant.eu.auth0.com/
AUTH_AUDIENCE=https://api.recon-platform.example
AUTH_JWKS_URL=
# Dev-only local HS256 signer. MUST be empty in production.
AUTH_DEV_SECRET=dev-only-not-for-production

# --- Connectors -----------------------------------------------------------
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
STRIPE_WEBHOOK_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# --- AI (advisory only; never authoritative) ------------------------------
AI_ENABLED=false
AI_PROVIDER=deterministic
AI_MODEL=
AI_API_KEY=
AI_LATENCY_BUDGET_MS=8000

# --- Secrets / KMS --------------------------------------------------------
KMS_KEY_ID=
CREDENTIAL_ENCRYPTION_KEY=

# --- Runtime --------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
